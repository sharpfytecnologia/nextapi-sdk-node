{
  "name": "@sharpfy/nextapi",
  "version": "0.2.1",
  "description": "SDK oficial da NextAPI (CNPJ, CEP, sócios, mercado) para Node.js, Deno, Bun e edge. Sem dependências.",
  "keywords": [
    "nextapi",
    "sharpfy",
    "cnpj",
    "consulta-cnpj",
    "simples-nacional",
    "inscricao-estadual",
    "cep",
    "sdk"
  ],
  "author": "Sharpfy <contato@sharpfy.com.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharpfytecnologia/nextapi-sdk-node.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist-test/tests/*.test.js && node scripts/test-cjs.cjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "homepage": "https://nextapi.com.br",
  "bugs": {
    "url": "https://github.com/sharpfytecnologia/nextapi-sdk-node/issues"
  }
}
